-- Dedicated application role for a generic managed PostgreSQL database.
-- Run ONCE as the database/schema owner after postgres_schema.sql on database "campusos".
-- Replace the placeholder with a long, unique password; never commit the replacement.
-- Use the resulting campusos_app credentials only in the Java API service, never in Vercel/browser variables.
CREATE ROLE campusos_app LOGIN PASSWORD 'REPLACE_WITH_A_LONG_RANDOM_PASSWORD';

GRANT CONNECT ON DATABASE campusos TO campusos_app;
GRANT USAGE ON SCHEMA public TO campusos_app;

-- Default to least privilege. The API should not own tables or connect as the database owner.
REVOKE ALL PRIVILEGES ON ALL TABLES IN SCHEMA public FROM campusos_app;
REVOKE ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public FROM campusos_app;
ALTER DEFAULT PRIVILEGES IN SCHEMA public REVOKE ALL ON TABLES FROM campusos_app;
ALTER DEFAULT PRIVILEGES IN SCHEMA public REVOKE ALL ON SEQUENCES FROM campusos_app;

GRANT SELECT (id, name, email, password, role, register_number, department, specialization, available, created_at)
    ON TABLE public.users TO campusos_app;
GRANT INSERT ON TABLE public.users TO campusos_app;
GRANT UPDATE (available) ON TABLE public.users TO campusos_app;

GRANT SELECT, INSERT ON TABLE public.issues, public.ticket_history, public.emergencies TO campusos_app;
GRANT SELECT ON TABLE public.tickets TO campusos_app;
GRANT INSERT ON TABLE public.tickets TO campusos_app;
GRANT UPDATE (assigned_technician_id, status, updated_at) ON TABLE public.tickets TO campusos_app;
GRANT SELECT, INSERT ON TABLE public.notifications TO campusos_app;
GRANT UPDATE (is_read) ON TABLE public.notifications TO campusos_app;
GRANT SELECT ON TABLE public.resources TO campusos_app;
GRANT SELECT, INSERT, DELETE ON TABLE public.bookings TO campusos_app;
GRANT SELECT, INSERT, DELETE ON TABLE public.token_revocations TO campusos_app;
GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE public.login_attempt_limits TO campusos_app;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO campusos_app;

-- Future identity sequences are usable; new tables intentionally receive no automatic table grants.
ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT USAGE, SELECT ON SEQUENCES TO campusos_app;
