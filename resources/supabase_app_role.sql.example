-- Example only: replace the placeholder with a unique, strong password before running.
-- Run this in the CAMPUSOS Supabase project's SQL Editor as an administrator.
-- Never commit the replaced password or put it in frontend/Vercel browser variables.
CREATE ROLE campusos_app LOGIN PASSWORD 'REPLACE_WITH_A_LONG_RANDOM_PASSWORD';

GRANT CONNECT ON DATABASE postgres TO campusos_app;
GRANT USAGE ON SCHEMA public TO campusos_app;

-- Remove broad grants if this script is being reapplied after an earlier version.
REVOKE ALL PRIVILEGES ON ALL TABLES IN SCHEMA public FROM campusos_app;
REVOKE ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public FROM campusos_app;
ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA public
    REVOKE ALL ON TABLES FROM campusos_app;
ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA public
    REVOKE ALL ON SEQUENCES FROM campusos_app;

-- Grant only operations used by the Java API. In particular, DELETE is limited to bookings.
GRANT SELECT, INSERT, UPDATE ON TABLE public.users, public.tickets, public.notifications TO campusos_app;
GRANT SELECT, INSERT ON TABLE public.issues, public.ticket_history, public.emergencies TO campusos_app;
GRANT SELECT ON TABLE public.resources TO campusos_app;
GRANT SELECT, INSERT, DELETE ON TABLE public.bookings TO campusos_app;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO campusos_app;

-- Future identity sequences are usable by the app. New tables intentionally receive no
-- automatic table grants; add explicit least-privilege grants in the relevant migration.
ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA public
    GRANT USAGE, SELECT ON SEQUENCES TO campusos_app;

-- When using the Supabase session pooler, the username is typically:
-- campusos_app.<project-ref>
-- Use port 5432 with sslmode=require for this persistent Java JDBC backend.
